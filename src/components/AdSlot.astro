---
/** Reserved ad space. Renders nothing until ads are enabled (PUBLIC_ADS_ENABLED=true). */
interface Props {
  kind: 'below-tool' | 'in-content' | 'sidebar';
}

const { kind } = Astro.props;
const enabled = import.meta.env.PUBLIC_ADS_ENABLED === 'true';
---

{enabled && <div class:list={['ad-slot', { 'ad-slot--sidebar': kind === 'sidebar' }]} data-ad-kind={kind} />}
