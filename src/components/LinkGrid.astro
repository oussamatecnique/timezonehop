---
import type { LinkItem } from './RelatedLinks.astro';

export interface LinkGroup {
  heading: string;
  id?: string;
  links: LinkItem[];
}

interface Props {
  groups: LinkGroup[];
  level?: 2 | 3;
}

const { groups, level = 2 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
---

<div class="link-groups">
  {
    groups.map(g => (
      <section class="link-group" id={g.id}>
        <Heading>{g.heading}</Heading>
        <ul class="link-columns">
          {g.links.map(l => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
