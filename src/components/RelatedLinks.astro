---
export interface LinkItem {
  href: string;
  label: string;
}

interface Props {
  heading: string;
  links: LinkItem[];
}

const { heading, links } = Astro.props;
---

{
  links.length > 0 && (
    <section class="stack-tight">
      <h2>{heading}</h2>
      <ul class="chips">
        {links.map(l => (
          <li>
            <a class="chip" href={l.href}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
