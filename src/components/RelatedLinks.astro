---
export interface LinkItem {
  href: string;
  label: string;
}

interface Props {
  heading: string;
  links: LinkItem[];
  /** chips for short lists, columns for long ones */
  variant?: 'chips' | 'columns';
}

const { heading, links, variant = 'chips' } = Astro.props;
---

{
  links.length > 0 && (
    <section class="stack-tight">
      <h2>{heading}</h2>
      {variant === 'chips' ? (
        <ul class="chips">
          {links.map(l => (
            <li>
              <a class="chip" href={l.href}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <ul class="link-columns">
          {links.map(l => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}
