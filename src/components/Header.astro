---
import Logo from './Logo.astro';
---

<header class="site-header">
  <a class="brand" href="/" aria-label="TimezoneHop home">
    <Logo />
    <span>TimezoneHop</span>
  </a>
  <nav class="site-nav" aria-label="Main">
    <a href="/time">World clock</a>
    <a href="/timezone">Time zones</a>
    <a href="/convert">Converter</a>
  </nav>
  <div class="header-search"><slot /></div>
  <button class="icon-button" type="button" data-theme-toggle aria-label="Switch between light and dark theme">
    <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
    </svg>
    <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4.5"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
  </button>
</header>
