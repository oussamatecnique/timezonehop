// Cloudflare Workers with static assets: the whole site is files in ./dist, no server code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timezonehop",
  "compatibility_date": "2026-10-01",
  // Serve only on timezonehop.com: no duplicate copy on *.workers.dev or preview URLs (SEO).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "timezonehop.com", "custom_domain": true }]
}
